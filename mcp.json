{
  "$schema": "https://json.schemastore.org/mcp.json",
  "mcpServers": {
    "urban-heat-toolbox": {
      "command": "npx",
      "args": [
        "-y",
        "@toolbox-sdk/server",
        "--tools-file=mcp/tools.yaml",
        "--stdio"
      ],
      "env": {
        "GOOGLE_CLOUD_PROJECT": "qwiklabs-gcp-04-4753f87c7a64"
      }
    },
    "bigquery-explorer": {
      "command": "npx",
      "args": [
        "-y",
        "@toolbox-sdk/server",
        "--prebuilt=bigquery",
        "--stdio"
      ],
      "env": {
        "GOOGLE_CLOUD_PROJECT": "qwiklabs-gcp-04-4753f87c7a64"
      }
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "-y",
        "shadcn@latest",
        "mcp"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-playwright"
      ]
    },
    "figma": {
      "command": "npx",
      "args": [
        "-y",
        "figma-mcp-server"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "git": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-git"
      ]
    }
  }
}
